{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "spacing": 0,
  "height": 0,
  "width": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "modules-left": [
    "clock",
    "custom/separator",
    "custom/idle-indicator",
    "custom/notification-silencing-indicator",
    "custom/voxtype",
    "custom/screenrecording-indicator",
    "custom/update",
    "custom/updatespacman",
    "tray",
    "custom/separator",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "custom/mpris"
  ],

"modules-right": ["group/right"],

  "group/right": {
    "orientation": "inherit",
    "modules": [ 
    "backlight",
    "bluetooth",
    "network",
    "pulseaudio",
    "battery",
    "memory"
    ]
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "cursor": true,
    "format": "{icon}"
},
"custom/separator": {
    "format": "|", 
    "tooltip": false
},
    "custom/windowpill": {
    "format": "{}",
    "exec": "~/.config/waybar/window_pill.py",
    "return-type": "json",
    "restart-interval": 1,
    "align": 0,
    "justify": "left"
  },
  "custom/updatespacman": {
    "format": "{}{icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": " 󰏖",
      "updated": ""
    },
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --no-zero-output"
  },
  "memory": {
    "interval": 2,
    "format": "<span size='9pt'></span> {icon} {used:0.1f}G",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"[float] kitty nmtui\")'",
      "format-icons": [
      "<span size='8pt'>━</span>",
      "<span size='8pt'>■</span>",
      "<span size='8pt' color='#f7b69a'>■■</span>",
      "<span size='8pt' color='#ef9875'>■■■</span>",
      "<span size='8pt' color='#e77b50'>■■■■</span>",
      "<span size='8pt' color='#df6124'>■■■■■</span>",
      "<span size='8pt' color='#d35720'>■■■■■■</span>",
      "<span size='8pt' color='#c64e1c'>■■■■■■■</span>",
      "<span size='8pt' color='#aa4318'>■■■■■■■■</span>",
      "<span size='8pt' color='#8e3813'>■■■■■■■■■</span>",
      "<span size='8pt' color='#722d0f'>■■■■■■■■■■</span>"
    ]
  },
  "clock": {
    "format": "{:%H:%M - %a, %d}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "on-click-right": "waypaper"
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon} {signalStrength}%",
    "format-ethernet": "󰈀 {bandwidthDownBytes:=}",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"[float] kitty nmtui\")'"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "",
    "format-icons": {
      "charging": [
       "󰢜 <span size='8pt' color='#df6124'>━</span>",
       "󰢜 <span size='8pt' color='#df6124'>■</span>",
       "󰂆 <span size='8pt' color='#dd7006'>■■</span>",
       "󰂇 <span size='8pt' color='#d88000'>■■■</span>",
       "󰂈 <span size='8pt' color='#d09000'>■■■■</span>",
       "󰢝 <span size='8pt' color='#c5a000'>■■■■■</span>",
       "󰂉 <span size='8pt' color='#b5af00'>■■■■■■</span>",
       "󰢞 <span size='8pt' color='#a2be00'>■■■■■■■</span>",
       "󰂊 <span size='8pt' color='#8acc00'>■■■■■■■■</span>",
       "󰂋 <span size='8pt' color='#68da00'>■■■■■■■■■</span>",
       "󰂅 <span size='8pt' color='#25e712'>■■■■■■■■■■</span>"
      ],
      "default": [
      "󰁺 <span size='8pt' color='#df6124'>━</span>",
      "󰁺 <span size='8pt' color='#df6124'>■</span>",
      "󰁻 <span size='8pt' color='#dd7006'>■■</span>",
      "󰁼 <span size='8pt' color='#d88000'>■■■</span>",
      "󰁽 <span size='8pt' color='#d09000'>■■■■</span>",
      "󰁾 <span size='8pt' color='#c5a000'>■■■■■</span>",
      "󰁿 <span size='8pt' color='#b5af00'>■■■■■■</span>",
      "󰂀 <span size='8pt' color='#a2be00'>■■■■■■■</span>",
      "󰂁 <span size='8pt' color='#8acc00'>■■■■■■■■</span>",
      "󰂂 <span size='8pt' color='#68da00'>■■■■■■■■■</span>",
      "󰁹 <span size='8pt' color='#25e712'>■■■■■■■■■■</span>"
      ]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{timeTo}",
    "tooltip-format-charging": "{timeTo}",
    "interval": 5,
    "on-click": "walker -m menus:power-profiles",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": " {status} {num_connections}",
    "format-off": "󰂲 OFF",
    "format-disabled": "󰂲 {status}",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "walker -m bluetooth" // walker bluethooth
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    }
  },
  "backlight": {
        "device": "intel_backlight",
        "rotate": 0,
        "format": "{icon} {percent}%",
        "tooltip-format": "🌕 {percent}%",
        "format-icons": [
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
    ]
   },
  "tray": {
    "icon-size": 12,
    "spacing": 5
  },
	"custom/mpris": {
		"exec": "python3 -u ~/.config/waybar/scrolling-mpris.py",
		"format": "{text}",
        "return-type": "json",
		"on-click": "playerctl play-pause",
        "tooltip": false
	},
  "custom/screenrecording-indicator": {
    "on-click": "omarchy-capture-screenrecording",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  },
}
